# Local orchestration state. The Docker image uses /data/agent-factory.db.
AGENT_FACTORY_DB=.agent-factory/state.db

# Optional directory containing reviewed agents, providers, workflows, and policy overrides.
# AGENT_FACTORY_CONFIG_DIR=./config

# Repository or directory provider subprocesses may inspect.
AGENT_FACTORY_WORKSPACE=.

# Optional GitHub target used by backlog synchronization.
AGENT_FACTORY_GITHUB_REPOSITORY=owner/repository

# Keep provider credentials in each provider CLI's own profile or OS keyring.
# Do not place tokens or passwords in this file.

# Durable orchestration. False preserves the existing synchronous engine.
TEMPORAL_ENABLED=false
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=agentfactory
TEMPORAL_TASK_QUEUE=agentfactory-main
TEMPORAL_UI_URL=http://localhost:8080

# Activity timing and bounded repair policy (seconds unless noted).
TEMPORAL_CONNECT_TIMEOUT_SECONDS=10
TEMPORAL_FAST_ACTIVITY_TIMEOUT_SECONDS=120
TEMPORAL_LLM_ACTIVITY_TIMEOUT_SECONDS=3600
TEMPORAL_HEARTBEAT_TIMEOUT_SECONDS=60
TEMPORAL_HEARTBEAT_INTERVAL_SECONDS=10
TEMPORAL_CANCELLATION_GRACE_SECONDS=15
AGENTFACTORY_MAX_REPAIR_ITERATIONS=5
