FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 AGENT_FACTORY_WORKSPACE=/data TEMPORAL_ENABLED=false
WORKDIR /source
COPY . /source
RUN pip install --no-cache-dir '.[web]' httpx && pip check \
    && useradd --uid 10001 --create-home loktest && mkdir -p /data /app && chown loktest:loktest /data /app
COPY --from=runtime serve.py domain_adapter.py snapshot.py gateway.py /app/
WORKDIR /app
USER 10001:10001
ENTRYPOINT ["python", "/app/serve.py"]
CMD ["lokvetia"]
