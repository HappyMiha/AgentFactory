{
  "packs": [
    {
      "id": "python-unittest",
      "commands": {
        "test": ["python", "-m", "unittest", "discover", "-s", "tests"],
        "lint": ["python", "-m", "compileall", "-q", "src", "tests"],
        "type_check": ["python", "-m", "compileall", "-q", "src"],
        "build": ["python", "-m", "build", "--no-isolation"],
        "security_scan": ["python", "-m", "unittest", "tests.test_policy_plane", "tests.test_sandbox"]
      }
    }
  ]
}
