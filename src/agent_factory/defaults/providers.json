{
  "providers": [
    {
      "id": "codex",
      "type": "cli",
      "enabled": true,
      "executable": "codex",
      "executable_candidates": [
        "%USERPROFILE%\\.codex\\plugins\\.plugin-appserver\\codex.exe",
        "%USERPROFILE%\\.codex\\.sandbox-bin\\codex.exe",
        "codex.exe"
      ],
      "args": ["exec", "--sandbox", "read-only", "--skip-git-repo-check", "--color", "never", "-"],
      "version_args": ["--version"],
      "prompt_transport": "stdin",
      "allow_execution": true,
      "allowed_roles": ["Policy Reviewer", "Implementation Worker", "Proxy Reviewer", "Validation Reviewer"],
      "max_timeout": 180,
      "max_output_chars": 100000
    },
    {
