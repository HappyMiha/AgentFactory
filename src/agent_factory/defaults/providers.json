      "version_args": ["--version"],
      "prompt_transport": "stdin",
      "allow_execution": true,
      "allowed_roles": ["Policy Reviewer", "Implementation Worker", "Proxy Reviewer", "Validation Reviewer"],
      "max_timeout": 180,
      "max_output_chars": 100000
